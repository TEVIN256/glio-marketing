# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings -> API). The publishable key is safe in the browser:
# every table is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Direct Postgres connection used for server-side writes (reports, syncs).
# Project Settings -> Database -> Connection string. Contains the database password.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Optional. Without it, report summaries use the deterministic template.
ANTHROPIC_API_KEY=

# Optional. 1 = show "Load demo data" (synthetic TikTok numbers) on client pages.
GLIO_DEMO_MODE=1

# TikTok Marketing API app (TikTok for Business developer portal -> My Apps).
# Set in Vercel: TIKTOK_APP_ID as Config, TIKTOK_APP_SECRET as SECRET. Never commit real values.
# Without them, client pages show "available once TikTok approves the GLIO app".
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Optional: must equal the redirect URL registered with TikTok exactly (default below).
# TIKTOK_REDIRECT_URI=https://www.glioagency.org/integrations/tiktok/callback

# Report emails (Resend, https://resend.com). The domain must be verified in Resend.
# Set in Vercel: RESEND_API_KEY as SECRET. Without it, "send now" and the daily job report RESEND_NOT_CONFIGURED.
RESEND_API_KEY=
# Optional (defaults shown):
# REPORTS_FROM=GLIO Reports <reports@glioagency.org>
# REPORTS_REPLY_TO=info@glioagency.org
# APP_URL=https://www.glioagency.org

# SECRET. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/reports (vercel.json).
# Any long random string (letters and digits).
CRON_SECRET=

