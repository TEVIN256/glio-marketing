# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings -> API). The publishable key is safe in the browser:
# every table is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Direct Postgres connection used for server-side writes (reports, syncs).
# Project Settings -> Database -> Connection string. Contains the database password.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Optional. Without it, report summaries use the deterministic template.
ANTHROPIC_API_KEY=

# Optional. 1 = show "Load demo data" (synthetic TikTok numbers) on client pages.
GLIO_DEMO_MODE=1
